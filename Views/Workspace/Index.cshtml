@{
    ViewData["Title"] = "Dock Workspace";
    Layout = null;
}

<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Dock Workspace
    </title>


    <!-- 
         COMPILED WORKSPACE CSS
         -->

    <link rel="stylesheet"
          href="/dist/workspace.css" />

</head>


<body>


    <!-- 
         TOP BRAND BAR
      -->

    <header class="workspace-brand-bar">

        <div class="workspace-logo">

            <span class="logo-block logo-blue">
            </span>

            <span class="logo-block logo-purple">
            </span>

            <strong>
                dockview
            </strong>

        </div>

    </header>


    <!-- 
         MAIN DOCKVIEW WORKSPACE

         workspace.js searches for this exact ID.
      
          -->

    <main id="dockview-container">
    </main>


    <!-- 
         FX RATES TEMPLATE
       -->

    <template id="fxrates-template">

        <partial name="Partials/_FxRatesPanel" />

    </template>


    <!-- 
         ORDERS TEMPLATE
  -->

    <template id="orders-template">

        <partial name="Partials/_OrdersPanel" />

    </template>


    <!-- 
         POSITIONS TEMPLATE
 -->

    <template id="positions-template">

        <partial name="Partials/_PositionsPanel" />

    </template>


    <!-- 
         VOL SURFACE TEMPLATE
      = -->

    <template id="volsurface-template">

        <partial name="Partials/_VolSurfacePanel" />

    </template>
    <!--
     NEWSWIRE
  -->

    <template id="news-template">

        <partial name="Partials/_NewsPanel" />

    </template>


    <!-- 
     TECH VIEW
   -->

    <template id="techview-template">

        <partial name="Partials/_TechViewPanel" />

    </template>

    <!-- 
         COMPILED WORKSPACE JAVASCRIPT

         type="module" is REQUIRED because
         workspace.js uses import statements.
       -->

    <script type="module"
            src="/dist/workspace.js">
    </script>


</body>

</html>