@{
    ViewData["Title"] = "Dock Workspace";
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Dock Workspace</title>

    <link rel="stylesheet"
          href="~/dist/workspace.css"
          asp-append-version="true" />

</head>

<body>

    <!-- ==========================================
         TOP APPLICATION BAR
         ========================================== -->

    <header class="app-header">

        <div class="brand">

            <div class="brand-logo">

                <span class="logo-block logo-cyan"></span>

                <span class="logo-block logo-blue"></span>

                <span class="logo-block logo-pink"></span>

            </div>

            <span class="brand-name">
                dockview
            </span>

        </div>

    </header>


    <!-- ==========================================
         DOCKVIEW WORKSPACE
         ========================================== -->

    <main class="workspace-shell">

        <div id="dockview-container">
        </div>

    </main>


    <!-- ==========================================
         OUR BUNDLED JAVASCRIPT
         ========================================== -->

    <script src="~/dist/workspace.js"
            asp-append-version="true">
    </script>

</body>

</html>