@{
    ViewData["Title"] = "Dock Workspace";
    Layout = null;
}

<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Dock Workspace
    </title>


    <!-- 
         COMPILED WORKSPACE CSS
     -->

    <link rel="stylesheet"
          href="/dist/workspace.css" />

</head>


<body>


    <!-- 
         TOP BRAND BAR
 -->

    <header class="workspace-brand-bar">


        <div class="workspace-logo">

            <span class="logo-block logo-blue">
            </span>

            <span class="logo-block logo-purple">
            </span>

            <strong>
                dockview
            </strong>

        </div>


        <!--
         WORKSPACE CONTROLS
      -->

        <div class="workspace-top-actions">


            <!-- QUICK THEME -->

            <select id="quick-theme-select"
                    class="quick-theme-select"
                    title="Change theme">

                <option value="light">
                    Light
                </option>

                <option value="dark">
                    Dark
                </option>

                <option value="visual-studio">
                    Visual Studio
                </option>

                <option value="nord">
                    Nord
                </option>

                <option value="catppuccin">
                    Catppuccin Mocha
                </option>

            </select>


            <!-- CONTROLS BUTTON -->

            <button type="button"
                    class="controls-theme-button"
                    id="controls-theme-button">

                <span>
                    ⚙
                </span>

                Controls &amp; Theme

            </button>


        </div>


    </header>

    <partial name="Partials/_ControlsThemePanel" />
    <!-- 
         MAIN DOCKVIEW CONTAINER

         workspace.js requires this exact id.
        -->

    <main id="dockview-container">
    </main>


    <!-- 
         LEFT WORKSPACE
     -->
    <!-- CORRELATION -->

    <template id="correlation-template">

        <partial name="Partials/_CorrelationPanel" />

    </template>


    <!-- ORDER BOOK -->

    <template id="orderbook-template">

        <partial name="Partials/_OrderBookPanel" />

    </template>


    <!--
         MIDDLE WORKSPACE
          -->
    <!-- FX RATES -->

    <template id="fxrates-template">

        <partial name="Partials/_FxRatesPanel" />

    </template>


    <!-- ORDERS -->

    <template id="orders-template">

        <partial name="Partials/_OrdersPanel" />

    </template>


    <!-- POSITIONS -->

    <template id="positions-template">

        <partial name="Partials/_PositionsPanel" />

    </template>


    <!-- VOL SURFACE -->

    <template id="volsurface-template">

        <partial name="Partials/_VolSurfacePanel" />

    </template>


    <!--
         RIGHT WORKSPACE
        -->
    <!-- NEWS -->

    <template id="news-template">

        <partial name="Partials/_NewsPanel" />

    </template>


    <!-- TECH VIEW -->

    <template id="techview-template">

        <partial name="Partials/_TechViewPanel" />

    </template>


    <!--
         COMPILED JAVASCRIPT

          -->

    <script type="module"
            src="/dist/workspace.js">
    </script>


</body>

</html>