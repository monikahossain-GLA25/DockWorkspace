<div class="bottom-tool-panel"
     data-output-panel>


    <div class="bottom-tool-titlebar">

        <div class="bottom-tool-title">

            <span class="bottom-tool-title-icon">
                ◫
            </span>

            <strong>
                Output
            </strong>

        </div>


        <div class="bottom-tool-actions">

            <button type="button"
                    class="bottom-tool-action"
                    data-bottom-collapse
                    title="Collapse bottom panel">

                ▾

            </button>


            <button type="button"
                    class="bottom-tool-action"
                    data-bottom-close
                    title="Close">

                ×

            </button>

        </div>

    </div>


    <div class="output-toolbar">

        <span>
            Show output from:
        </span>


        <select class="output-select">

            <option>
                DockWorkspace
            </option>

            <option>
                ASP.NET Core
            </option>

            <option>
                esbuild
            </option>

        </select>

    </div>


    <div class="output-content">


        <div class="output-line">

            <span class="output-time">
                09:42:00
            </span>

            <span>
                Starting DockWorkspace...
            </span>

        </div>


        <div class="output-line">

            <span class="output-time">
                09:42:01
            </span>

            <span>
                Loading Dockview layout.
            </span>

        </div>


        <div class="output-line">

            <span class="output-time">
                09:42:02
            </span>

            <span class="output-success">
                Build completed successfully.
            </span>

        </div>


        <div class="output-line">

            <span class="output-time">
                09:42:02
            </span>

            <span>
                Workspace ready.
            </span>

        </div>


    </div>


</div>