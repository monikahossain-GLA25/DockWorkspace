<div class="bottom-tool-panel"
     data-logs-panel>


    <!-- 
         INTERNAL TITLE BAR
       -->

    <div class="bottom-tool-titlebar">

        <div class="bottom-tool-title">

            <span class="bottom-tool-title-icon">
                ▣
            </span>

            <strong>
                Logs
            </strong>

        </div>


        <div class="bottom-tool-actions">

            <button type="button"
                    class="bottom-tool-action"
                    data-bottom-collapse
                    title="Collapse bottom panel">

                ▾

            </button>


            <button type="button"
                    class="bottom-tool-action"
                    data-bottom-close
                    title="Close">

                ×

            </button>

        </div>

    </div>


    <!-- 
         LOG TOOLBAR
    -->

    <div class="logs-toolbar">

        <div class="logs-filter-group">

            <button type="button"
                    class="logs-filter active"
                    data-log-filter="all">

                All

            </button>


            <button type="button"
                    class="logs-filter"
                    data-log-filter="info">

                Info

            </button>


            <button type="button"
                    class="logs-filter"
                    data-log-filter="warning">

                Warning

            </button>


            <button type="button"
                    class="logs-filter"
                    data-log-filter="error">

                Error

            </button>

        </div>


        <span class="logs-count">
            8 entries
        </span>

    </div>


    <!-- 
         LOG CONTENT
         Dummy interface data
    -->

    <div class="logs-content">


        <div class="log-row"
             data-log-level="info">

            <span class="log-time">
                09:42:10
            </span>

            <span class="log-level log-level-info">
                INFO
            </span>

            <span class="log-message">
                Workspace initialized successfully.
            </span>

        </div>


        <div class="log-row"
