<!--
     BACKDROP
     -->

<div class="workspace-settings-backdrop"
     id="workspace-settings-backdrop">
</div>


<!-- 
     CONTROLS & THEME
     -->

<aside class="workspace-settings-drawer"
       id="workspace-settings-drawer"
       aria-hidden="true">


    <!-- 
         HEADER
        -->

    <div class="settings-drawer-header">


        <div class="settings-drawer-title">

            <span class="settings-icon">
                ⚙
            </span>

            <strong>
                Controls &amp; Theme
            </strong>

        </div>


        <div class="settings-header-actions">

            <button type="button"
                    class="settings-reset-button"
                    id="settings-reset-button">

                ↻ Reset

            </button>


            <button type="button"
                    class="settings-close-button"
                    id="settings-close-button"
                    title="Close">

                ×

            </button>

        </div>


    </div>


    <!-- 
         MAIN TABS
         -->

    <div class="settings-main-tabs">

        <button type="button"
                class="settings-main-tab active"
                data-settings-tab="theme">

            Theme

        </button>


        <button type="button"
                class="settings-main-tab"
                data-settings-tab="controls">

            Controls

        </button>

    </div>


    <!-- 
         DRAWER BODY
       -->

    <div class="settings-drawer-body">


        <!-- 
             THEME
            -->

        <section class="settings-pane active"
                 data-settings-pane="theme">


            <!-- 
                 THEME PRESETS
                 -->

            <div class="settings-section">

                <div class="settings-section-heading">

                    <span>
                        🎨
                    </span>

                    <strong>
                        Theme
                    </strong>

                </div>


                <div class="theme-option-list">


                    <button type="button"
                            class="theme-option active"
                            data-theme-key="light">

                        <span class="theme-option-copy">

                            <strong>
                                Light
                            </strong>

                            <small>
                                Clean light workspace
                            </small>

                        </span>

                    </button>


                    <button type="button"
                            class="theme-option"
                            data-theme-key="dark">

                        <span class="theme-option-copy">

                            <strong>
                                Dark
                            </strong>

                            <small>
                                Standard dark
                            </small>

                        </span>

                    </button>


                    <button type="button"
                            class="theme-option"
                            data-theme-key="visual-studio">

                        <span class="theme-option-copy">

                            <strong>
                                Visual Studio
                            </strong>

                            <small>
                                IDE-style dark theme
                            </small>

                        </span>

                    </button>


                    <button type="button"
                            class="theme-option"
                            data-theme-key="nord">

                        <span class="theme-option-copy">

                            <strong>
                                Nord
                            </strong>

                            <small>
                                Cool blue palette
                            </small>

                        </span>

                    </button>


                    <button type="button"
                            class="theme-option"
                            data-theme-key="catppuccin">

                        <span class="theme-option-copy">

                            <strong>
                                Catppuccin Mocha
                            </strong>

                            <small>
                                Lavender dark palette
                            </small>

                        </span>

                    </button>


                </div>

            </div>


            <!-- 
                 LAYOUT
                 -->

            <details class="theme-accordion"
                     open>

                <summary>
                    Layout
                </summary>


                <div class="theme-accordion-content">


                    <div class="settings-range-row">

                        <label for="layout-gap">
                            Gap
                        </label>

                        <input type="range"
                               id="layout-gap"
                               data-layout-control="gap"
                               min="0"
                               max="20"
                               value="0" />

                        <output id="layout-gap-value">
                            0px
                        </output>

                    </div>


                    <div class="settings-range-row">

                        <label for="layout-spacing">
                            Spacing
                        </label>

                        <input type="range"
                               id="layout-spacing"
                               data-layout-control="spacing"
                               min="0"
                               max="20"
                               value="0" />

                        <output id="layout-spacing-value">
                            0px
                        </output>

                    </div>


                    <div class="settings-range-row">

                        <label for="layout-padding">
                            Padding
                        </label>

                        <input type="range"
                               id="layout-padding"
                               data-layout-control="padding"
                               min="0"
                               max="24"
                               value="0" />

                        <output id="layout-padding-value">
                            0px
                        </output>

                    </div>


                    <div class="settings-range-row">

                        <label for="tab-bar-height">
                            Tab height
                        </label>

                        <input type="range"
                               id="tab-bar-height"
                               data-layout-control="tabBarHeight"
                               min="28"
                               max="50"
                               value="35" />

                        <output id="tab-bar-height-value">
                            35px
                        </output>

                    </div>


                    <div class="settings-range-row">

                        <label for="workspace-font-size">
                            Font size
                        </label>

                        <input type="range"
                               id="workspace-font-size"
                               data-layout-control="fontSize"
                               min="10"
                               max="18"
                               value="13" />

                        <output id="workspace-font-size-value">
                            13px
                        </output>

                    </div>


                </div>

            </details>


            <!-- 
                 DRAG & DROP
                  -->

            <details class="theme-accordion"
                     open>

                <summary>
                    ✥ Drag &amp; Drop
                </summary>


                <div class="theme-accordion-content">


                    <!-- OVERLAY MOUNTING -->

                    <div class="theme-setting-row">

                        <span>
                            DnD Overlay
                        </span>


                        <div class="settings-segmented">

                            <button type="button"
                                    class="active"
                                    data-theme-choice="dndOverlayMounting"
                                    data-theme-value="relative">

                                relative

                            </button>


                            <button type="button"
                                    data-theme-choice="dndOverlayMounting"
                                    data-theme-value="absolute">

                                absolute

                            </button>

                        </div>

                    </div>


                    <!-- PANEL TARGET -->

                    <div class="theme-setting-row">

                        <span>
                            DnD Panel Target
                        </span>


                        <div class="settings-segmented">

                            <button type="button"
                                    class="active"
                                    data-theme-choice="dndPanelOverlay"
                                    data-theme-value="content">

                                content

                            </button>


                            <button type="button"
                                    data-theme-choice="dndPanelOverlay"
                                    data-theme-value="group">

                                group

                            </button>

                        </div>

                    </div>


                    <!-- TAB INDICATOR -->

                    <div class="theme-setting-row">

                        <span>
                            Tab Indicator
                        </span>


                        <div class="settings-segmented">

                            <button type="button"
                                    class="active"
                                    data-theme-choice="dndTabIndicator"
                                    data-theme-value="fill">

                                fill

                            </button>


                            <button type="button"
                                    data-theme-choice="dndTabIndicator"
                                    data-theme-value="line">

                                line

                            </button>

                        </div>

                    </div>


                    <!-- DRAG BACKGROUND -->

                    <label class="theme-variable-row">

                        <span>
                            Drag-over bg
                        </span>

                        <input type="text"
                               data-dv-variable="--dv-drag-over-background-color"
                               placeholder="#35395d80" />

                    </label>


                    <!-- DRAG BORDER -->

                    <label class="theme-variable-row">

                        <span>
                            Drag-over border
                        </span>

                        <input type="text"
                               data-theme-border
                               placeholder="none" />

                    </label>


                </div>

            </details>


            <!-- 
                 BACKGROUNDS
                  -->
        

            <details class="theme-accordion"
                     open>

                <summary>
                    Backgrounds
                </summary>


                <div class="theme-accordion-content">


                    <!-- PANEL BACKGROUND -->

                    <div class="theme-variable-row">

                        <span>
                            Panel background
                        </span>


                        <div class="theme-color-control">

                            <input type="color"
                                   class="theme-color-picker"
                                   value="#ffffff"
                                   data-color-variable="--dv-group-view-background-color"
                                   title="Choose panel background" />


                            <input type="text"
                                   class="theme-color-value"
                                   data-dv-variable="--dv-group-view-background-color"
                                   placeholder="#ffffff" />


                            <button type="button"
                                    class="theme-color-clear"
                                    data-clear-variable="--dv-group-view-background-color"
                                    title="Reset">

                                ×

                            </button>

                        </div>

                    </div>


                    <!-- TAB BAR BACKGROUND -->

                    <div class="theme-variable-row">

                        <span>
                            Tab bar background
                        </span>


                        <div class="theme-color-control">

                            <input type="color"
                                   class="theme-color-picker"
                                   value="#f3f3f3"
                                   data-color-variable="--dv-tabs-and-actions-container-background-color"
                                   title="Choose tab bar background" />


                            <input type="text"
                                   class="theme-color-value"
                                   data-dv-variable="--dv-tabs-and-actions-container-background-color"
                                   placeholder="#f3f3f3" />


                            <button type="button"
                                    class="theme-color-clear"
                                    data-clear-variable="--dv-tabs-and-actions-container-background-color"
                                    title="Reset">

                                ×

                            </button>

                        </div>

                    </div>


                    <!-- SEPARATOR -->

                    <div class="theme-variable-row">

                        <span>
                            Separator
                        </span>


                        <div class="theme-color-control">

                            <input type="color"
                                   class="theme-color-picker"
                                   value="#808080"
                                   data-color-variable="--dv-separator-border"
                                   title="Choose separator colour" />


                            <input type="text"
                                   class="theme-color-value"
                                   data-dv-variable="--dv-separator-border"
                                   placeholder="#80808059" />


                            <button type="button"
                                    class="theme-color-clear"
                                    data-clear-variable="--dv-separator-border"
                                    title="Reset">

                                ×

                            </button>

                        </div>

                    </div>


                    <!-- PANE HEADER BORDER -->

                    <div class="theme-variable-row">

                        <span>
                            Pane header border
                        </span>


                        <div class="theme-color-control">

                            <input type="color"
                                   class="theme-color-picker"
                                   value="#333333"
                                   data-color-variable="--dv-paneview-header-border-color"
                                   title="Choose pane header border" />


                            <input type="text"
                                   class="theme-color-value"
                                   data-dv-variable="--dv-paneview-header-border-color"
                                   placeholder="#333333" />


                            <button type="button"
                                    class="theme-color-clear"
                                    data-clear-variable="--dv-paneview-header-border-color"
                                    title="Reset">

                                ×

                            </button>

                        </div>

                    </div>


                </div>

            </details>



            <!-- 
     ACTIVE GROUP TABS
     -->

            <details class="theme-accordion"
                     open>

                <summary>
                    Active Group Tabs
                </summary>


                <div class="theme-accordion-content">


                    <!-- VISIBLE BACKGROUND -->

                    <div class="theme-variable-row">

                        <span>
                            Visible tab bg
                        </span>


                        <div class="theme-color-control">

                            <input type="color"
                                   class="theme-color-picker"
                                   value="#ffffff"
                                   data-color-variable="--dv-activegroup-visiblepanel-tab-background-color" />


                            <input type="text"
                                   class="theme-color-value"
                                   data-dv-variable="--dv-activegroup-visiblepanel-tab-background-color"
                                   placeholder="#ffffff" />


                            <button type="button"
                                    class="theme-color-clear"
                                    data-clear-variable="--dv-activegroup-visiblepanel-tab-background-color">

                                ×

                            </button>

                        </div>

                    </div>


                    <!-- HIDDEN BACKGROUND -->

                    <div class="theme-variable-row">

                        <span>
                            Hidden tab bg
                        </span>


                        <div class="theme-color-control">

                            <input type="color"
                                   class="theme-color-picker"
                                   value="#ececec"
                                   data-color-variable="--dv-activegroup-hiddenpanel-tab-background-color" />


                            <input type="text"
                                   class="theme-color-value"
                                   data-dv-variable="--dv-activegroup-hiddenpanel-tab-background-color"
                                   placeholder="#ececec" />


                            <button type="button"
                                    class="theme-color-clear"
                                    data-clear-variable="--dv-activegroup-hiddenpanel-tab-background-color">

                                ×

                            </button>

                        </div>

                    </div>


                    <!-- VISIBLE TEXT -->

                    <div class="theme-variable-row">

                        <span>
                            Visible tab text
                        </span>


                        <div class="theme-color-control">

                            <input type="color"
                                   class="theme-color-picker"
                                   value="#333333"
                                   data-color-variable="--dv-activegroup-visiblepanel-tab-color" />


                            <input type="text"
                                   class="theme-color-value"
                                   data-dv-variable="--dv-activegroup-visiblepanel-tab-color"
                                   placeholder="#333333" />


                            <button type="button"
                                    class="theme-color-clear"
                                    data-clear-variable="--dv-activegroup-visiblepanel-tab-color">

                                ×

                            </button>

                        </div>

                    </div>


                    <!-- HIDDEN TEXT -->

                    <div class="theme-variable-row">

                        <span>
                            Hidden tab text
                        </span>


                        <div class="theme-color-control">

                            <input type="color"
                                   class="theme-color-picker"
                                   value="#333333"
                                   data-color-variable="--dv-activegroup-hiddenpanel-tab-color" />


                            <input type="text"
                                   class="theme-color-value"
                                   data-dv-variable="--dv-activegroup-hiddenpanel-tab-color"
                                   placeholder="#333333b3" />


                            <button type="button"
                                    class="theme-color-clear"
                                    data-clear-variable="--dv-activegroup-hiddenpanel-tab-color">

                                ×

                            </button>

                        </div>

                    </div>


                </div>

            </details>



            <!-- 
     INACTIVE GROUP TABS
 -->

            <details class="theme-accordion"
                     open>

                <summary>
                    Inactive Group Tabs
                </summary>


                <div class="theme-accordion-content">


                    <!-- VISIBLE BACKGROUND -->

                    <div class="theme-variable-row">

                        <span>
                            Visible tab bg
                        </span>


                        <div class="theme-color-control">

                            <input type="color"
                                   class="theme-color-picker"
                                   value="#ffffff"
                                   data-color-variable="--dv-inactivegroup-visiblepanel-tab-background-color" />


                            <input type="text"
                                   class="theme-color-value"
                                   data-dv-variable="--dv-inactivegroup-visiblepanel-tab-background-color"
                                   placeholder="#ffffff" />


                            <button type="button"
                                    class="theme-color-clear"
                                    data-clear-variable="--dv-inactivegroup-visiblepanel-tab-background-color">

                                ×

                            </button>

                        </div>

                    </div>


                    <!-- HIDDEN BACKGROUND -->

                    <div class="theme-variable-row">

                        <span>
                            Hidden tab bg
                        </span>


                        <div class="theme-color-control">

                            <input type="color"
                                   class="theme-color-picker"
                                   value="#ececec"
                                   data-color-variable="--dv-inactivegroup-hiddenpanel-tab-background-color" />


                            <input type="text"
                                   class="theme-color-value"
                                   data-dv-variable="--dv-inactivegroup-hiddenpanel-tab-background-color"
                                   placeholder="#ececec" />


                            <button type="button"
                                    class="theme-color-clear"
                                    data-clear-variable="--dv-inactivegroup-hiddenpanel-tab-background-color">

                                ×

                            </button>

                        </div>

                    </div>


                    <!-- VISIBLE TEXT -->

                    <div class="theme-variable-row">

                        <span>
                            Visible tab text
                        </span>


                        <div class="theme-color-control">

                            <input type="color"
                                   class="theme-color-picker"
                                   value="#333333"
                                   data-color-variable="--dv-inactivegroup-visiblepanel-tab-color" />


                            <input type="text"
                                   class="theme-color-value"
                                   data-dv-variable="--dv-inactivegroup-visiblepanel-tab-color"
                                   placeholder="#333333" />


                            <button type="button"
                                    class="theme-color-clear"
                                    data-clear-variable="--dv-inactivegroup-visiblepanel-tab-color">

                                ×

                            </button>

                        </div>

                    </div>


                    <!-- HIDDEN TEXT -->

                    <div class="theme-variable-row">

                        <span>
                            Hidden tab text
                        </span>


                        <div class="theme-color-control">

                            <input type="color"
                                   class="theme-color-picker"
                                   value="#333333"
                                   data-color-variable="--dv-inactivegroup-hiddenpanel-tab-color" />


                            <input type="text"
                                   class="theme-color-value"
                                   data-dv-variable="--dv-inactivegroup-hiddenpanel-tab-color"
                                   placeholder="#333333b3" />


                            <button type="button"
                                    class="theme-color-clear"
                                    data-clear-variable="--dv-inactivegroup-hiddenpanel-tab-color">

                                ×

                            </button>

                        </div>

                    </div>


                </div>

            </details>

            </details>


        </section>


        <!-- 
             CONTROLS
              -->

        <section class="settings-pane"
                 data-settings-pane="controls">


            <!-- 
                 GRID
              -->

            <div class="settings-section">

                <div class="settings-section-heading">

                    <span>
                        ⊞
                    </span>

                    <strong>
                        Grid
                    </strong>

                </div>


                <div class="control-button-grid">


                    <button type="button"
                            data-layout-action="load">

                        Load

                    </button>


                    <button type="button"
                            data-layout-action="save">

                        Save

                    </button>


                    <button type="button"
                            data-layout-action="clear-saved">

                        Clear

                    </button>


                    <button type="button"
                            data-layout-action="reset-layout">

                        ↻ Reset

                    </button>


                </div>


                <div class="control-button-grid control-button-grid-wide">


                    <button type="button"
                            data-layout-action="add-panel">

                        + Add Panel

                    </button>


                    <button type="button"
                            data-layout-action="add-group">

                        ⊞ Add Group

                    </button>


                </div>


                <div class="control-status"
                     id="control-status">
                </div>

            </div>


            <!-- 
                 ACTIVE PANEL
                 -->

            <div class="settings-section">

                <div class="settings-section-heading">

                    <strong>
                        Active Panel
                    </strong>

                </div>


                <div class="active-object-row">

                    <code id="active-panel-id">
                        none
                    </code>

                </div>

            </div>


            <!-- 
                 ACTIVE GROUP
               -->

            <div class="settings-section">

                <div class="settings-section-heading">

                    <strong>
                        Active Group
                    </strong>

                </div>


                <div class="active-object-row">

                    <code id="active-group-id">
                        none
                    </code>

                </div>


                <label class="control-select-row">

                    <span>
                        Header
                    </span>


                    <select id="active-group-header">

                        <option value="top">
                            top
                        </option>

                        <option value="bottom">
                            bottom
                        </option>

                        <option value="left">
                            left
                        </option>

                        <option value="right">
                            right
                        </option>

                    </select>

                </label>

            </div>


            <!--
                 VIEW
                 -->

            <div class="settings-section">

                <div class="settings-section-heading">

                    <strong>
                        View
                    </strong>

                </div>


                <label class="settings-toggle-row">

                    <span>
                        Drag &amp; Drop
                    </span>

                    <input type="checkbox"
                           data-dock-option="dndEnabled"
                           checked />

                </label>


                <label class="settings-toggle-row">

                    <span>
                        Floating groups
                    </span>

                    <input type="checkbox"
                           data-dock-option="floatingEnabled"
                           checked />

                </label>


                <label class="settings-toggle-row disabled-setting">

                    <span>
                        DnD compass
                        <small>
                            Enterprise
                        </small>
                    </span>

                    <input type="checkbox"
                           disabled />

                </label>


                <label class="settings-toggle-row disabled-setting">

                    <span>
                        Smart guides
                        <small>
                            Enterprise
                        </small>
                    </span>

                    <input type="checkbox"
                           disabled />

                </label>


            </div>


        </section>


    </div>


</aside>