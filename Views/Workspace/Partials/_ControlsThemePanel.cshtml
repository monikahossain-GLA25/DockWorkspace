<!-- 
     SETTINGS BACKDROP
 -->

<div class="workspace-settings-backdrop"
     id="workspace-settings-backdrop">
</div>


<!-- 
     CONTROLS & THEME DRAWER
 -->

<aside class="workspace-settings-drawer"
       id="workspace-settings-drawer"
       aria-hidden="true">


    <!--
         HEADER
         -->

    <div class="settings-drawer-header">

        <div class="settings-drawer-title">

            <span class="settings-icon">
                ⚙
            </span>

            <strong>
                Controls &amp; Theme
            </strong>

        </div>


        <div class="settings-header-actions">

            <button type="button"
                    class="settings-reset-button"
                    id="settings-reset-button">

                ↻ Reset

            </button>


            <button type="button"
                    class="settings-close-button"
                    id="settings-close-button"
                    title="Close">

                ×

            </button>

        </div>

    </div>


    <!-- 
         THEME / CONTROLS TABS
     -->

    <div class="settings-main-tabs">

        <button type="button"
                class="settings-main-tab active"
                data-settings-tab="theme">

            Theme

        </button>


        <button type="button"
                class="settings-main-tab"
                data-settings-tab="controls">

            Controls

        </button>

    </div>


    <!-- 
         BODY
    -->

    <div class="settings-drawer-body">


        <!-- 
             THEME PANEL
          -->

        <section class="settings-pane active"
                 data-settings-pane="theme">


            <div class="settings-section">


                <div class="settings-section-heading">

                    <span>
                        🎨
                    </span>

                    <strong>
                        Theme
                    </strong>

                </div>


                <p class="settings-help-text">

                    Choose one of the five workspace themes.

                </p>


                <div class="theme-option-list">


                    <!-- LIGHT -->

                    <button type="button"
                            class="theme-option active"
                            data-theme-key="light">

                        <span class="theme-preview theme-preview-light">

                            <span></span>
                            <span></span>
                            <span></span>

                        </span>


                        <span class="theme-option-copy">

                            <strong>
                                Light
                            </strong>

                            <small>
                                Clean light workspace
                            </small>

                        </span>


                        <span class="theme-check">
                            ✓
                        </span>

                    </button>


                    <!-- DARK -->

                    <button type="button"
                            class="theme-option"
                            data-theme-key="dark">

                        <span class="theme-preview theme-preview-dark">

                            <span></span>
                            <span></span>
                            <span></span>

                        </span>


                        <span class="theme-option-copy">

                            <strong>
                                Dark
                            </strong>

                            <small>
                                Standard dark workspace
                            </small>

                        </span>


                        <span class="theme-check">
                            ✓
                        </span>

                    </button>


                    <!-- VISUAL STUDIO -->

                    <button type="button"
                            class="theme-option"
                            data-theme-key="visual-studio">

                        <span class="theme-preview theme-preview-vs">

                            <span></span>
                            <span></span>
                            <span></span>

                        </span>


                        <span class="theme-option-copy">

                            <strong>
                                Visual Studio
                            </strong>

                            <small>
                                Visual Studio inspired
                            </small>

                        </span>


                        <span class="theme-check">
                            ✓
                        </span>

                    </button>


                    <!-- NORD -->

                    <button type="button"
                            class="theme-option"
                            data-theme-key="nord">

                        <span class="theme-preview theme-preview-nord">

                            <span></span>
                            <span></span>
                            <span></span>

                        </span>


                        <span class="theme-option-copy">

                            <strong>
                                Nord
                            </strong>

                            <small>
                                Cool blue Nord palette
                            </small>

                        </span>


                        <span class="theme-check">
                            ✓
                        </span>

                    </button>


                    <!-- CATPPUCCIN -->

                    <button type="button"
                            class="theme-option"
                            data-theme-key="catppuccin">

                        <span class="theme-preview theme-preview-catppuccin">

                            <span></span>
                            <span></span>
                            <span></span>

                        </span>


                        <span class="theme-option-copy">

                            <strong>
                                Catppuccin Mocha
                            </strong>

                            <small>
                                Soft purple dark workspace
                            </small>

                        </span>


                        <span class="theme-check">
                            ✓
                        </span>

                    </button>


                </div>

            </div>

        </section>


        <!-- 
             CONTROLS PANEL
         -->

        <section class="settings-pane"
                 data-settings-pane="controls">


            <!-- 
                 LAYOUT
             -->

            <div class="settings-section">


                <div class="settings-section-heading">

                    <span>
                        ⊞
                    </span>

                    <strong>
                        Layout
                    </strong>

                </div>


                <!-- GAP -->

                <div class="settings-range-row">

                    <label for="layout-gap">

                        Gap

                    </label>


                    <input type="range"
                           id="layout-gap"
                           data-layout-control="gap"
                           min="0"
                           max="20"
                           value="0"
                           step="1" />


                    <output id="layout-gap-value">
                        0px
                    </output>

                </div>


                <!-- SPACING -->

                <div class="settings-range-row">

                    <label for="layout-spacing">

                        Spacing

                    </label>


                    <input type="range"
                           id="layout-spacing"
                           data-layout-control="spacing"
                           min="0"
                           max="20"
                           value="0"
                           step="1" />


                    <output id="layout-spacing-value">
                        0px
                    </output>

                </div>


                <!-- PADDING -->

                <div class="settings-range-row">

                    <label for="layout-padding">

                        Padding

                    </label>


                    <input type="range"
                           id="layout-padding"
                           data-layout-control="padding"
                           min="0"
                           max="24"
                           value="0"
                           step="1" />


                    <output id="layout-padding-value">
                        0px
                    </output>

                </div>


                <!-- TAB BAR HEIGHT -->

                <div class="settings-range-row">

                    <label for="tab-bar-height">

                        Tab Bar Height

                    </label>


                    <input type="range"
                           id="tab-bar-height"
                           data-layout-control="tabBarHeight"
                           min="28"
                           max="50"
                           value="35"
                           step="1" />


                    <output id="tab-bar-height-value">
                        35px
                    </output>

                </div>


                <!-- FONT SIZE -->

                <div class="settings-range-row">

                    <label for="workspace-font-size">

                        Font Size

                    </label>


                    <input type="range"
                           id="workspace-font-size"
                           data-layout-control="fontSize"
                           min="10"
                           max="18"
                           value="13"
                           step="1" />


                    <output id="workspace-font-size-value">
                        13px
                    </output>

                </div>


            </div>


            <!-- 
                 INFORMATION
               -->

            <div class="settings-section settings-information">

                <strong>
                    What these controls change
                </strong>


                <p>

                    <b>Gap</b> changes the space between Dockview
                    groups.

                </p>


                <p>

                    <b>Spacing</b> changes the outer breathing room
                    inside each panel.

                </p>


                <p>

                    <b>Padding</b> changes the padding around each
                    Razor component.

                </p>


                <p>

                    <b>Tab Bar Height</b> changes the Dockview tab
                    strip height.

                </p>


                <p>

                    <b>Font Size</b> changes the Dockview tab font.

                </p>

            </div>


        </section>


    </div>


</aside>