<div class="fx-panel" data-fx-panel>

    <!-- 
         FX INTERNAL TAB BAR
         -->

    <div class="fx-subtabs">

        <button type="button"
                class="fx-subtab active"
                data-fx-tab="g10">

            <span>G10</span>

            <span class="fx-tab-close">
                ×
            </span>

        </button>


        <button type="button"
                class="fx-subtab"
                data-fx-tab="em">

            <span>EM</span>

            <span class="fx-tab-close">
                ×
            </span>

        </button>


        <button type="button"
                class="fx-subtab"
                data-fx-tab="crosses">

            <span>Crosses</span>

            <span class="fx-tab-close">
                ×
            </span>

        </button>

    </div>


    <!-- 
         G10
         -->

    <section class="fx-tab-pane active"
             data-fx-pane="g10">

        <partial name="Partials/_FxRatesG10" />

    </section>


    <!-- 
         EM
       -->

    <section class="fx-tab-pane"
             data-fx-pane="em">

        <partial name="Partials/_FxRatesEM" />

    </section>


    <!-- 
         CROSSES
          -->

    <section class="fx-tab-pane"
             data-fx-pane="crosses">

        <partial name="Partials/_FxRatesCrosses" />

    </section>

</div>