<div class="fx-panel"
     data-fx-panel>

    <div class="fx-subtabs">

        <button type="button"
                class="fx-subtab active"
                data-fx-tab="g10">
            G10
        </button>

        <button type="button"
                class="fx-subtab"
                data-fx-tab="em">
            EM
        </button>

        <button type="button"
                class="fx-subtab"
                data-fx-tab="crosses">
            Crosses
        </button>

    </div>


    <section class="fx-tab-pane active"
             data-fx-pane="g10">

        <partial name="Partials/_FxRatesG10" />

    </section>


    <section class="fx-tab-pane"
             data-fx-pane="em">

        <partial name="Partials/_FxRatesEM" />

    </section>


    <section class="fx-tab-pane"
             data-fx-pane="crosses">

        <partial name="Partials/_FxRatesCrosses" />

    </section>

</div>