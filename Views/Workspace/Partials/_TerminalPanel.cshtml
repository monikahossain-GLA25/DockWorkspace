<div class="bottom-tool-panel"
     data-terminal-panel>


    <!-- 
         TITLE BAR
         -->

    <div class="bottom-tool-titlebar">

        <div class="bottom-tool-title">

            <span class="bottom-tool-title-icon">
                ▱
            </span>

            <strong>
                Terminal
            </strong>

        </div>


        <div class="bottom-tool-actions">

            <button type="button"
                    class="bottom-tool-action"
                    data-bottom-collapse
                    title="Collapse bottom panel">

                ▾

            </button>


            <button type="button"
                    class="bottom-tool-action"
                    data-bottom-close
                    title="Close">

                ×

            </button>

        </div>

    </div>


    <!-- 
         TERMINAL PLACEHOLDER
       -->

    <div class="terminal-content">


        <div class="terminal-placeholder">

            <span class="terminal-placeholder-icon">
                ▱
            </span>


            <strong>
                Terminal
            </strong>


            <span>
                Terminal interface placeholder
            </span>

        </div>


    </div>


</div>