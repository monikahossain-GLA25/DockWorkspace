<div class="bottom-tool-panel"
     data-problems-panel>


    <div class="bottom-tool-titlebar">

        <div class="bottom-tool-title">

            <span class="bottom-tool-title-icon">
                ◇
            </span>

            <strong>
                Problems
            </strong>

        </div>


        <div class="bottom-tool-actions">

            <button type="button"
                    class="bottom-tool-action"
                    data-bottom-collapse
                    title="Collapse bottom panel">

                ▾

            </button>


            <button type="button"
                    class="bottom-tool-action"
                    data-bottom-close
                    title="Close">

                ×

            </button>

        </div>

    </div>


    <div class="problems-toolbar">

        <span class="problem-summary problem-error-summary">

            0 Errors

        </span>


        <span class="problem-summary problem-warning-summary">

            0 Warnings

        </span>


        <span class="problem-summary problem-info-summary">

            0 Messages

        </span>

    </div>


    <div class="problems-empty">


        <div class="problems-empty-icon">
            ✓
        </div>


        <strong>
            No problems detected
        </strong>


        <span>
            Workspace interface is ready.
        </span>


    </div>


</div>